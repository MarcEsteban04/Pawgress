# ---------------------------------------------------------------------------
# Pawgress — environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Read these through `src/config/env.ts`, never `process.env` directly, so a
# missing value fails at the boundary with the variable's name in the message.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
# Public base URL of the running app. Used for auth redirects and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pawgress"

# --- Supabase (Sprint 09) ----------------------------------------------
# Until BOTH of the two public values below are set, the app runs without auth:
# `supabaseConfigured()` is false, the proxy passes everything through, and the
# Data Access Layer hands out a preview session in development only. It fails
# closed in production — no Supabase there means no session at all.
#
# LOCAL STACK: run `npm run db:start` and paste the values it prints.
# The API URL is http://127.0.0.1:54321 and the keys are fixed demo keys that
# are identical on every machine — they are safe to share and worthless.
#
# HOSTED PROJECT: Supabase dashboard -> Project Settings -> API keys.
NEXT_PUBLIC_SUPABASE_URL=""

# The browser-safe key. Projects created before the 2025 rename call this the
# `anon` key; newer ones call it the *publishable* key. Set whichever your
# project gives you — both names are read, and the newer one wins.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. BYPASSES Row Level Security — it can read and write every
# student's rows. Never prefix it with NEXT_PUBLIC_, never import it into a
# client component, and never reach for it to work around an RLS policy.
# Older projects call this the `service_role` key.
SUPABASE_SECRET_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Account-wide personal access token (sbp_...). Used only by
# `npm run auth:configure`, which sets up SMTP and pushes supabase/templates/ to
# the hosted project so the email templates cannot drift from the repo. This is
# NOT a project key — create one at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=""

# --- Outgoing email (Sprint 10) ----------------------------------------
# Supabase refuses to accept a custom email template until custom SMTP is set
# up, and its built-in sender is rate limited to a few messages an hour and is
# not for production. These are read ONLY by `npm run auth:configure`, which
# pushes them to the project — the app itself never sends email directly.
#
# GMAIL (fastest to start, development only — see docs/supabase.md §6):
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT="587"
#   SMTP_USER="you@gmail.com"
#   SMTP_PASS="<16-character App Password, spaces removed>"
#   SMTP_SENDER_EMAIL="you@gmail.com"   # must equal SMTP_USER; Gmail rewrites it
#
# A transactional provider (Brevo, Resend, Mailgun) before real students exist.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Must be an address the provider has authorised, or sending is refused.
SMTP_SENDER_EMAIL=""
SMTP_SENDER_NAME="Pawgress"

# --- Background jobs (Sprint 32) ---------------------------------------
# Shared secret for the worker endpoint at /api/jobs/run. There is no user
# session on a worker call, so this is what authorises it — an open worker
# endpoint lets anyone drain another student’s queue and spend their quota.
# Generate one with:
#   node -e "console.log(crypto.randomUUID().replace(/-/g, ''))"
# Minimum 16 characters. Without it the endpoint refuses every call, and the
# queue only drains via the pg_cron sweeper (docs/architecture.md §5).
JOBS_SECRET=""

# --- AI provider (Sprint 31+) ------------------------------------------
# Server-only key for the LLM used by the assistant, reviewer and quiz generators.
ANTHROPIC_API_KEY=""
# Optional. Defaults to claude-opus-5 — see src/lib/ai/models.ts for why the
# default is the strongest model rather than the cheapest: a reviewer a student
# cannot trust is worth nothing, and the per-user daily quota is the cost
# control. Set claude-sonnet-5 or claude-haiku-4-5 to trade quality for cost
# knowingly.
AI_CHAT_MODEL=""

# Optional, Sprint 33. The model that reads text out of photos. Transcription is
# not reasoning, so a cheaper model does the job — but which trade to make is
# yours, so there is no cheaper default. claude-haiku-4-5 is roughly a fifth the
# cost of the default; leave blank to use AI_CHAT_MODEL.
AI_OCR_MODEL=""

# Embeddings provider for material chunking / vector search (RAG).
#
# Anthropic publishes no embeddings endpoint, so this is a SECOND provider with
# its own key. Chosen in Sprint 35: OpenAI text-embedding-3-small, because it is
# 1536-dimensional and material_chunks.embedding is vector(1536) — so no
# migration and nothing to re-embed. Get a key at platform.openai.com.
#
# Cost is small but real: ~$0.02 per million tokens, so a 100-page PDF is well
# under a cent. Embeddings are counted in ai_calls like every other model call,
# but they do NOT draw on the daily generation allowance — a student should not
# lose their reviewers because they uploaded a long document.
#
# A model of a different width (Voyage is 1024, Gemini 768) needs a migration to
# change the column AND a re-embed of everything already indexed.
EMBEDDINGS_API_KEY=""
# Optional. Defaults to text-embedding-3-small.
EMBEDDINGS_MODEL=""
