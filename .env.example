# ---------------------------------------------------------------------------
# Pawgress — environment variables
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# --- App ---------------------------------------------------------------
# Public base URL of the running app. Used for auth redirects and metadata.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Pawgress"

# --- Supabase (Sprint 09) ----------------------------------------------
# Project URL and anon key are safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI provider (Sprint 31+) ------------------------------------------
# Server-only key for the LLM used by the assistant, reviewer and quiz generators.
ANTHROPIC_API_KEY=""
AI_CHAT_MODEL="claude-sonnet-5"

# Embeddings provider for material chunking / vector search (RAG).
EMBEDDINGS_API_KEY=""
EMBEDDINGS_MODEL=""
